#!/usr/bin/env ruby

name = File.basename(Dir.pwd)
path = "#{ENV.fetch("HOME")}/.puma-dev/#{name}"

unless File.exist?(path)
  puts "No puma-dev entry found for #{name}"
  exit 1
end

unless File.exist?(".pumaenv")
  puts "Warning: No .pumaenv file found in #{Dir.pwd}. The assets pipeline may not work correctly."
  print "Create .pumaenv? [Y/n] "
  answer = $stdin.gets&.chomp
  if answer.nil? || answer.empty? || answer =~ /\Ay/i
    File.write(".pumaenv", "CONFIG=config/puma.rb\n")
    puts "Created .pumaenv."
  end
end

system("open", "https://#{name}.test", exception: true)
