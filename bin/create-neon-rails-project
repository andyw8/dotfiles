#!/usr/bin/env ruby

require "json"
require "net/http"
require "open3"
require "uri"

DATABASES = %w[primary cache queue cable].freeze
RENDER_API_KEY_ITEM_ID = ENV.fetch("RENDER_API_KEY_ITEM_ID")
ENVIRONMENT_VARIABLES = {
  "primary" => "DATABASE_URL",
  "cache" => "CACHE_DATABASE_URL",
  "queue" => "QUEUE_DATABASE_URL",
  "cable" => "CABLE_DATABASE_URL"
}.freeze

def run_neon(*arguments)
  stdout, stderr, status = Open3.capture3("neon", *arguments)
  abort stderr unless status.success?
  stdout
end

def run_1password(*arguments)
  stdout, stderr, status = Open3.capture3("op", *arguments)
  abort "Could not retrieve the Render API key from 1Password: #{stderr}" unless status.success?
  stdout
end

def render_request(api_key, method, path, body = nil)
  uri = URI("https://api.render.com/v1#{path}")
  request = method.new(uri)
  request["Authorization"] = "Bearer #{api_key}"
  request["Content-Type"] = "application/json"
  request.body = JSON.generate(body) if body

  response = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) do |http|
    http.request(request)
  end
  abort "Render API request failed (#{response.code}): #{response.body}" unless response.is_a?(Net::HTTPSuccess)

  JSON.parse(response.body)
end

def git_remote
  stdout, stderr, status = Open3.capture3("git", "config", "--get", "remote.origin.url")
  abort "Could not determine the current Git repository remote: #{stderr}" unless status.success?

  stdout.strip
end

def canonical_repository(repository)
  repository.delete_suffix(".git").delete_suffix("/")
end

def render_service_id(api_key, repository)
  repository = canonical_repository(repository)
  cursor = nil

  loop do
    path = "/services?limit=100"
    path += "&cursor=#{URI.encode_www_form_component(cursor)}" if cursor
    services = render_request(api_key, Net::HTTP::Get, path)
    service = services.find do |entry|
      service_repository = entry.dig("service", "repo")
      service_repository && canonical_repository(service_repository) == repository
    end
    return service.dig("service", "id") if service

    break if services.empty? || services.last["cursor"].nil?

    cursor = services.last.fetch("cursor")
  end

  abort "Could not find a Render service for repository #{repository.inspect}."
end

abort "Error: the Neon CLI is not installed or is not on PATH." unless system("command -v neon > /dev/null 2>&1")
abort "Error: the 1Password CLI is not installed or is not on PATH." unless system("command -v op > /dev/null 2>&1")

default_project_name = File.basename(Dir.pwd)
print "Project name [#{default_project_name}]: "
project_name = STDIN.gets.to_s.strip
project_name = default_project_name if project_name.empty?
abort "Error: project name cannot be empty." if project_name.empty?

print "Region [us-west-2]: "
region = STDIN.gets.to_s.strip
region = "us-west-2" if region.empty?
region_id = region.start_with?("aws-") ? region : "aws-#{region}"

render_api_key = run_1password(
  "item", "get", RENDER_API_KEY_ITEM_ID,
  "--fields", "label=credential",
  "--reveal"
).strip
abort "Error: Render API key cannot be empty." if render_api_key.empty?
render_service = render_service_id(render_api_key, git_remote)
puts "Using Render service #{render_service}."

puts "Creating Neon project #{project_name.inspect} in #{region_id.inspect}..."
project_json = run_neon(
  "projects", "create",
  "--output", "json",
  "--name", project_name,
  "--region-id", region_id,
  "--database", "primary"
)

project = JSON.parse(project_json)
project_id = project.dig("project", "id") || project["project_id"] || project["id"]
abort "Could not find the project ID in Neon CLI output." unless project_id

DATABASES.drop(1).each do |database_name|
  puts "Creating database #{database_name.inspect}..."
  run_neon("databases", "create", "--project-id", project_id, "--name", database_name)
end

puts "Created project #{project_name.inspect} (#{project_id}) with databases: primary, cache, queue, cable."
puts
puts "Database connection strings:"
connection_strings = {}
DATABASES.each do |database_name|
  connection_string = run_neon(
    "connection-string",
    "--project-id", project_id,
    "--database-name", database_name
  )
  connection_strings[database_name] = connection_string.strip
  puts "#{database_name}: #{connection_strings[database_name]}"
end

puts
puts "Adding environment variables to Render service #{render_service}..."
DATABASES.each do |database_name|
  variable_name = ENVIRONMENT_VARIABLES.fetch(database_name)
  render_request(
    render_api_key,
    Net::HTTP::Put,
    "/services/#{render_service}/env-vars/#{variable_name}",
    {"value" => connection_strings.fetch(database_name)}
  )
  puts "Added #{variable_name}."
end
