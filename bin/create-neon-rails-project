#!/usr/bin/env ruby

require "json"
require "open3"

DATABASES = %w[primary cache queue cable].freeze
ENVIRONMENT_VARIABLES = {
  "primary" => "DATABASE_URL",
  "cache" => "CACHE_DATABASE_URL",
  "queue" => "QUEUE_DATABASE_URL",
  "cable" => "CABLE_DATABASE_URL"
}.freeze

def run_neon(*arguments)
  stdout, stderr, status = Open3.capture3("neon", *arguments)
  abort stderr unless status.success?
  stdout
end

abort "Error: the Neon CLI is not installed or is not on PATH." unless system("command -v neon > /dev/null 2>&1")

default_project_name = File.basename(Dir.pwd)
$stderr.print "Project name [#{default_project_name}]: "
project_name = STDIN.gets.to_s.strip
project_name = default_project_name if project_name.empty?
abort "Error: project name cannot be empty." if project_name.empty?

$stderr.print "Region [us-west-2]: "
region = STDIN.gets.to_s.strip
region = "us-west-2" if region.empty?
region_id = region.start_with?("aws-") ? region : "aws-#{region}"

project_json = run_neon(
  "projects", "create",
  "--output", "json",
  "--name", project_name,
  "--region-id", region_id,
  "--database", "primary"
)

project = JSON.parse(project_json)
project_id = project.dig("project", "id") || project["project_id"] || project["id"]
abort "Could not find the project ID in Neon CLI output." unless project_id

DATABASES.drop(1).each do |database_name|
  $stderr.puts "Creating database #{database_name.inspect}..."
  run_neon("databases", "create", "--project-id", project_id, "--name", database_name)
end

connection_strings = {}
DATABASES.each do |database_name|
  connection_string = run_neon(
    "connection-string",
    "--project-id", project_id,
    "--database-name", database_name
  )
  connection_strings[database_name] = connection_string.strip
end

puts JSON.generate(
  ENVIRONMENT_VARIABLES.to_h { |database_name, variable_name| [variable_name, connection_strings.fetch(database_name)] }
)
