#!/usr/bin/env ruby

require "fileutils"

FOLDER = "#{ENV['HOME']}/Library/Mobile Documents/iCloud~com~openplanetsoftware~just-press-record/Documents"

def process(f)
  return if f.include?("processed.m4a") || f.include?("failed.m4a")

  command = "strings '#{f}' | tail -n 1 | sed 's/^[^\{]*//' | jq -r '._root.txscriptv2.tx._data' | base64 --decode"
  result = `#{command}`

  state = "processed"
  if result.size < 5 # TODO find a better way to check if the result is valid
    relative_path = f.gsub(FOLDER, "")
    result = "Failed to extract text from #{relative_path}"
    state = "failed"
  end
  new_name = f.gsub(".m4a", ".#{state}.m4a")

  system("~/src/github.com/andyw8/dotfiles/bin/omni \"Voice Memo: #{result}\"", exception: true)
  FileUtils.move(f, new_name)
rescue
  puts "Command: #{command}"
  raise
end

Dir["#{FOLDER}/**/*.{m4a,wav}"].each do |f|
  process(f)
end
