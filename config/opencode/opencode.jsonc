{
  "$schema": "https://opencode.ai/config.json",
  "formatter": {}, // enable all formatters
  "mcp": {
    "render": {
      "type": "remote",
      "url": "https://mcp.render.com/mcp"
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  }
}
