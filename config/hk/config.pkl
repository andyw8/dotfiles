amends "package://github.com/jdx/hk/releases/download/v1.54.1/hk@1.54.1#/Config.pkl"

hooks {
  ["post-merge"] {
    steps {
      ["bundle-install"] {
        check = "bundle install"
        condition = "exec('test -f Gemfile || ls *.gemspec >/dev/null 2>&1')"
      }
      ["yarn-install"] {
        check = "yarn install"
        condition = "exec('test -f yarn.lock')"
      }
      ["bun-install"] {
        check = "bun install"
        condition = "exec('test -f bun.lockb')"
      }
      ["npm-install"] {
        check = "npm install"
        condition = "exec('test -f package-lock.json')"
      }
    }
  }
}
