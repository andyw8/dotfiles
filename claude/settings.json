{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(npm run lint)",
      "Bash(npm run test:*)",
      "Read(~/.zshrc)"
    ],
    "deny": [
      "Read(~/Downloads/**)",
      "Edit(~/Downloads/**)",
      "Write(~/Downloads/**)",
      "Read(~/Desktop/**)",
      "Edit(~/Desktop/**)",
      "Write(~/Desktop/**)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -title \"Claude Code\" -message \"Awaiting your input\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "turbocommit run"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/andy/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "cctop@cctop": false,
    "swift-lsp@claude-plugins-official": false,
    "ruby-lsp@claude-plugins-official": false
  },
  "alwaysThinkingEnabled": false,
  "effortLevel": "high",
  "fastMode": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": false,
  "feedbackSurveyState": {
    "lastShownTime": 1754004924311
  },
  "tui": "fullscreen"
}
